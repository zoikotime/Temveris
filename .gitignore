# =========================
# 🔹 Postman / API testing
# =========================
*.postman_collection.json
*.postman_environment.json

# =========================
# 🔹 Node / Frontend
# =========================
node_modules/
frontend/node_modules/

dist/
frontend/dist/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# 🔹 Python / Backend
# =========================
venv/
.venv/

__pycache__/
*.pyc
*.pyo
*.pyd

# =========================
# 🔹 Environment Variables (VERY IMPORTANT)
# =========================
.env
*.env
.env.local
*.env.local
frontend/.env
frontend/.env.local
backend/.env
backend/.env.local

# Env files carrying a FURTHER suffix — .env.production, .env.prod.backup, and
# friends. The rules above miss every one of them: `*.env` only matches names
# that END in .env, and `.env` matches that exact name alone. This was not
# theoretical — backend/.env.production.backup sat untracked-but-committable
# with a live Supabase URL and password in it, one `git add -A` from entering
# history. Patterns without a slash match at any depth, so this covers
# backend/ and frontend/ too. Templates are re-admitted below.
.env.*
!.env.example

# =========================
# 🔹 Logs / Temp files
# =========================
*.log
*.txt
# requirements.txt is the backend's dependency manifest — it must be tracked.
!backend/requirements.txt

# =========================
# 🔹 OS / Editor
# =========================
.DS_Store
Thumbs.db

.vscode/
.idea/

# =========================
# 🔹 Project Specific
# =========================
tracker-data/
tmp_release/
dist_new/
*.exe

# Local databases and spreadsheets (may hold real data)
*.db
*.sqlite
*.xlsx

# =========================
# 🔹 Misc
# =========================
*.swp
*.swo
.claude/
# Stray file named "|" (created by a mistyped shell redirect)
\|
# ...which Git for Windows/MSYS stores as U+F07C

