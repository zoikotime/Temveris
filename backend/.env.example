DATABASE_URL=your_database_url_here
SECRET_KEY=your_secret_key
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key
# Anon (public) key from Supabase → Settings → API. Required by the
# /auth/sso/supabase-exchange bridge that completes Google Sign-In via
# Supabase Auth.
SUPABASE_ANON_KEY=your_supabase_anon_key

# Email — primary sender
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL=your_from_email

# Email recipients
ADMIN_EMAIL=your_admin_email
HR_EMAIL=your_hr_email

# Resend API (preferred on Cloud Run)
RESEND_API_KEY=your_resend_api_key

# URLs
FRONTEND_URL=your_frontend_url
BACKEND_URL=your_backend_url
APP_DOWNLOAD_URL=          





#env sample
# =========================
# DATABASE
# =========================
DATABASE_URL=your_database_url_here

# =========================
# JWT
# =========================
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =========================
# FRONTEND
# =========================
FRONTEND_URL=your_frontend_url

# =========================
# EMAIL (GoDaddy SMTP)
# =========================
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL=your_from_email
ADMIN_EMAIL=your_admin_email

# =========================
# EMAIL — Resend API (primary for Cloud Run)
# =========================
RESEND_API_KEY=your_resend_api_key

# Public HTTPS URL for the Temveris logo PNG used in outbound emails.
# Backend mounts /email-assets at the same origin as the frontend, so this
# resolves to backend/app/email_assets/temveris_logo.png.
EMAIL_LOGO_URL=your_email_logo_url

# =========================
# DESKTOP APP DOWNLOAD
# =========================
APP_DOWNLOAD_URL=

# =========================
# STORAGE (Supabase)
# =========================
STORAGE_BACKEND=supabase
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_SCREENSHOTS_BUCKET=screenshots

# ─────────────────────────────────────────────────────────────────
# Single Sign-On (Google)
# Register the OAuth app in:
#   Google : https://console.cloud.google.com/apis/credentials
# The redirect URI is BACKEND_URL + the path shown.
# Leave these blank to hide the SSO button in the UI.
# ─────────────────────────────────────────────────────────────────
# Google – redirect URI: {BACKEND_URL}/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Auth cookie / refresh-token settings ──
REFRESH_COOKIE_NAME=zt_refresh
REFRESH_TOKEN_REMEMBER_DAYS=30
REFRESH_TOKEN_SESSION_HOURS=12
COOKIE_SAMESITE=lax
# PRODUCTION: set to 1 so the refresh cookie is only sent over HTTPS.
COOKIE_SECURE=1
# PRODUCTION: comma-separated EXACT frontend origin(s). Must be set — if empty,
# CORS falls back to echoing any Origin with credentials (insecure).
CORS_ALLOW_ORIGINS=https://your-frontend-domain.example

# ─────────────────────────────────────────────────────────────────
# Public self-service signup — bot challenge (Cloudflare Turnstile)
# Guards POST /api/v1/signup, which mints a tenant, an admin account and a
# trial subscription from an unauthenticated request.
#
# PRODUCTION: BOTH must be set before public signup is exposed. With no secret
# the challenge is SKIPPED (a warning is logged on every signup) and only the
# per-IP rate limit and DB velocity buckets stand between an attacker and
# automated tenant creation.
#
# Pair with VITE_TURNSTILE_SITE_KEY in the frontend — enable them together, or
# the form will 403 because it sends no challenge_token.
# Secret key: https://dash.cloudflare.com → Turnstile → your widget
# ─────────────────────────────────────────────────────────────────
SIGNUP_CHALLENGE_SECRET=
# Hard-require a valid challenge token. Defaults to "is a secret configured?".
# Setting this true WITHOUT a secret fails closed (signups are refused) rather
# than silently allowing them.
SIGNUP_CHALLENGE_REQUIRED=true

# ─────────────────────────────────────────────────────────────────
# Proxy / client-IP resolution  (see app/client_ip.py)
# Trailing X-Forwarded-For entries to skip when resolving the client IP for
# rate limiting and fraud velocity buckets.
#
# Leave unset (== 0) for Cloud Run with no extra proxy: the rightmost entry is
# the address the infrastructure appended, which a client cannot forge.
# Increase by one for each additional appending proxy in front (e.g. an external
# HTTPS load balancer). Getting it wrong yields a coarser bucket, never a
# spoofable one.
#
# Do NOT set FORWARDED_ALLOW_IPS=* to "fix" client IPs — uvicorn's
# always-trust path takes the LEFTMOST forwarded entry, which is
# client-supplied, and would make per-IP limits trivially bypassable.
# ─────────────────────────────────────────────────────────────────
TRUSTED_PROXY_HOPS=0
