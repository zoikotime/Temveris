{
  "name": "temveris-desktop",
  "version": "1.0.13",
  "description": "Temveris Desktop — Workforce Intelligence Platform",
  "author": {
    "name": "Temveris",
    "email": "info@temveris.example"
  },
  "homepage": "https://app.temveris.example",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "publish:win": "node scripts/publish-update.js win",
    "publish:mac": "node scripts/publish-update.js mac",
    "publish:linux": "node scripts/publish-update.js linux",
    "release:win": "electron-builder --win && node scripts/publish-update.js win",
    "release:mac": "electron-builder --mac && node scripts/publish-update.js mac",
    "release:linux": "electron-builder --linux && node scripts/publish-update.js linux"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "auto-launch": "^5.0.6",
    "electron-updater": "^6.8.3",
    "node-fetch": "^3.3.2"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.temveris.app",
    "productName": "Temveris",
    "copyright": "Copyright © 2026 Temveris",
    "icon": "assets/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "browser-tracker.js",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Temveris-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons",
      "category": "Office",
      "maintainer": "Temveris <info@temveris.example>",
      "synopsis": "Workforce Intelligence Platform",
      "desktop": {
        "StartupWMClass": "Temveris"
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Temveris",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "generic",
      "url": "https://updates.temveris.example/${os}/",
      "channel": "latest",
      "useMultipleRangeRequest": false
    }
  }
}