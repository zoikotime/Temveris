# Frontend (Vite) environment variables.
# Copy this file to `.env.local` and fill in real values.
# Variables MUST be prefixed with VITE_ to be exposed to client code.

# Temveris backend base URL. Leave blank for same-origin deploys
# (when the frontend is served by the FastAPI backend itself).
VITE_API_URL=https://your-api.example.com

# ── Supabase (used only for Google Sign-In OAuth flow) ───────────────
# Get these from Supabase dashboard → Settings → API.
# The Anon (public) key is safe to expose to browsers.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Public origin to use when the SPA is running in an embedded shell
# (e.g. Electron `file://`) and supabase needs an absolute redirect URL.
VITE_PUBLIC_ORIGIN=https://app.temveris.example

# Dev server only: backend the Vite proxy forwards /api, /auth, /ws ... to.
# Defaults to http://127.0.0.1:8000; set it when that port is taken.
# VITE_DEV_API_TARGET=http://127.0.0.1:8010

# ── Public self-service signup — bot challenge (Cloudflare Turnstile) ─
# Public site key for the widget on /start. Leave blank to render no widget
# (dev/CI); the signup form then does not wait for a token.
# Must be enabled together with SIGNUP_CHALLENGE_SECRET in the backend — the
# backend verifies the token server-side and will 403 if it expects one and the
# form sends none.
VITE_TURNSTILE_SITE_KEY=
